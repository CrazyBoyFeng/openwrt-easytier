+/// Wrapper that attaches resolved peer address info to a Tunnel.
+/// Sourced from http_connector when that module is compiled;
+/// defined locally when http-connector feature is disabled.
+#[cfg(not(feature = "http-connector"))]
+pub(super) struct TunnelWithInfo {
+    inner: Box<dyn Tunnel>,
+    info: TunnelInfo,
+}
+
+#[cfg(not(feature = "http-connector"))]
+impl TunnelWithInfo {
+    pub fn new(inner: Box<dyn Tunnel>, info: TunnelInfo) -> Self {
+        Self { inner, info }
+    }
+}
+
+#[cfg(not(feature = "http-connector"))]
+impl Tunnel for TunnelWithInfo {
+    fn split(&self) -> (Pin<Box<dyn ZCPacketStream>>, Pin<Box<dyn ZCPacketSink>>) {
+        self.inner.split()
+    }
+
+    fn info(&self) -> Option<TunnelInfo> {
+        Some(self.info.clone())
+    }
+}
