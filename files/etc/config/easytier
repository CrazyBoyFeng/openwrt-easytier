# EasyTier configuration for OpenWrt
# Documentation: https://easytier.cn
# Source: https://github.com/EasyTier/EasyTier
#
# Each 'config easytier' section defines one virtual network instance.
# Multiple sections can be defined to join multiple networks simultaneously.
# The section name is used as the default value for --instance-name and
# --dev-name (et_{section_name}), and as the OpenWrt firewall zone name.
#
# For parameter details, constraints, and mutual exclusions, refer to:
# https://github.com/EasyTier/EasyTier/blob/main/easytier-core/README.md

config easytier 'easytier'
        option enabled '1'

        # ===== 网络设置 (Network Settings) =====

        option network_name 'easytier'
        option network_secret ''

        # option ipv4 '10.144.144.1/24'
        # option ipv6 ''
        # option dhcp '0'
        # option hostname ''
        # option instance_name ''
        # list peers 'tcp://1.2.3.4:11010'
        # list external_node 'tcp://public.example.com:11010'
        # list proxy_networks '192.168.1.0/24'

        # ===== 监听器设置 (Listener Settings) =====

        # list listeners 'tcp://0.0.0.0:11010'
        # list mapped_listeners 'tcp://123.123.123.123:11010'
        # option default_protocol ''
        # option no_listener '0'

        # ===== RPC 设置 (RPC Settings) =====

        # option rpc_portal ''
        # option rpc_portal_whitelist ''

        # ===== 加密与安全 (Encryption & Security) =====

        # option disable_encryption '0'
        # option encryption_algorithm ''

        # ===== 其他设置 (Other Settings) =====

        # option dev_name ''
        # option mtu ''
        # option accept_dns '0'
        # option tld_dns_zone 'et.net'
        # option latency_first '0'
        # option compression ''
        # option proxy_forward_by_system '0'

        # ===== P2P 设置 (P2P Settings) =====

        # option disable_p2p '0'
        # option p2p_only '0'
        # option lazy_p2p '0'
        # option need_p2p '0'
        # option disable_udp_hole_punching '0'
        # option disable_tcp_hole_punching '0'
        # option disable_sym_hole_punching '0'

        # ===== 日志设置 (Logging Settings) =====

        option console_log_level 'info'
        # option file_log_level ''
        # option file_log_dir ''
        # option file_log_size ''
        # option file_log_count ''

        # ===== OpenWrt 集成 (OpenWrt Integration) =====

        option auto_firewall '1'
        option firewall_zone 'lan'
        option auto_dnsmasq '1'
