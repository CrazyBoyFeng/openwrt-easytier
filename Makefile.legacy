# SPDX-License-Identifier: Apache-2.0
#
# Copyright (C) 2025 CrazyBoyFeng
#
# Legacy Makefile for OpenWrt 23.05.x SDK.
# This Makefile packages prebuilt easytier-core binaries into .ipk files.
# It does NOT compile Rust — binaries must be pre-compiled by the
# 25.12.4 CI step and placed in PREBUILT_DIR before this Makefile is used.
#
# This Makefile intentionally does NOT follow OpenWrt package submission
# standards (no rust-package.mk dependency, no RustBinPackage macro).

include $(TOPDIR)/rules.mk

PKG_NAME:=easytier
PKG_VERSION:=2.6.4
PKG_RELEASE:=2

PKG_MAINTAINER:=CrazyBoyFeng
PKG_LICENSE:=Apache-2.0

include $(INCLUDE_DIR)/package.mk

# ============ easytier ============
define Package/easytier
  SECTION:=net
  CATEGORY:=Network
  SUBMENU:=VPN
  TITLE:=EasyTier P2P Mesh VPN
  URL:=https://github.com/EasyTier/EasyTier
  DEPENDS:=+kmod-tun
endef

define Package/easytier/description
  EasyTier is a simple, decentralized and secure mesh VPN
  with WireGuard support. It connects your devices into a
  single virtual LAN, even behind NAT.
endef

# ============ Build/Compile ============
# Copy prebuilt binary from PREBUILT_DIR (set by CI).
# Single line (no define/endef) for sed-friendliness.
# EASYTIER_COMPILE
Build/Compile=mkdir -p $(PKG_INSTALL_DIR)/bin && $(CP) $(PREBUILT_DIR)/default/easytier-core $(PKG_INSTALL_DIR)/bin/

# ============ Install ============
define Package/easytier/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_INSTALL_DIR)/bin/easytier-core $(1)/usr/bin/
	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_CONF) ./files/etc/config/easytier $(1)/etc/config/easytier
	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./files/etc/init.d/easytier $(1)/etc/init.d/easytier
endef

$(eval $(call BuildPackage,easytier))
